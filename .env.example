# Host-run backend: copy this file to backend/.env (`cp .env.example backend/.env`).
# The backend reads .env from its working directory, backend/, never the repo root.
# The values below fit the host loop: the backend on :8000 and Vite on :5173.

# ── database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://molab:molab@localhost:5432/molab

# ── auth / identity ────────────────────────────────────────
SECRET_KEY=dev-secret-change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=60
PUBLIC_API_URL=http://localhost:8000
# Where the SPA is served; OIDC logins end on {PUBLIC_APP_URL}/auth/callback.
# The host loop's SPA is the Vite dev server. Leave it unset only where the
# SPA shares PUBLIC_API_URL's origin (e.g. behind one ingress).
PUBLIC_APP_URL=http://localhost:5173
# OIDC_PROVIDERS=[]        # JSON list; trusted_email_linking defaults false
# Each issuer is written exactly as the provider's discovery document has it, e.g.
# OIDC_PROVIDERS=[{"kind":"oidc","slug":"keycloak","display_name":"Keycloak","issuer":"https://sso.example.com/realms/main","client_id":"marimohub","client_secret":"change-me","trusted_email_linking":false}]
# Sign in with Google: set both to add the provider (slug "google", issuer
# https://accounts.google.com, account chooser on). Register the redirect URI
# {PUBLIC_API_URL}/api/auth/oidc/google/callback on a Google "Web application"
# OAuth client, e.g. http://localhost:8000/api/auth/oidc/google/callback.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=change-me
# GOOGLE_HOSTED_DOMAIN=example.com   # optional: only this Google Workspace domain may sign in
# OIDC_HTTP_PROXY_URL=               # optional egress proxy for identity-provider calls only

# ── workspace lifecycle ────────────────────────────────────
# WORKSPACE_ARCHIVE_RETENTION_DAYS=30

# ── Runtime ─────────────────────────────────────────────────
SESSION_BACKEND=subprocess
# SESSION_READY_TIMEOUT_SECONDS=30.0
# kube backend only (SESSION_BACKEND=kube):
# SESSION_NAMESPACE=marimohub-sessions
# SESSION_SERVICE_DNS_SUFFIX=svc
# SESSION_SERVICE_PORT=8080
# SESSION_RUNTIME_IMAGE=          # empty → controller default (CR spec.image omitted)

# ── notebook source storage ────────────────────────────────
# NOTEBOOK_STORAGE_BACKEND=postgres

# ── database TLS ───────────────────────────────────────────
# DATABASE_CA_FILE=          # path to a mounted CA bundle; required (chart-enforced) on OpenShift

# ── GitLab notebook import ─────────────────────────────────
# GITLAB_IMPORT_ENABLED=false
# GITLAB_IMPORT_PROXY_URL=    # optional administrator-supplied egress proxy
# GITLAB_IMPORT_ALLOWED_HOSTS=[]   # JSON list; required non-empty when enabled

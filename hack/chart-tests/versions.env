# Pinned sources of the OpenShift and Prometheus Operator schemas that
# hack/chart-tests uses. Sourced by helm-check.sh and platform-install-test.sh,
# next to hack/tools/versions.env. Bump a pin here and rerun make helm-check.

# datreeio/CRDs-catalog: JSON schemas for kubeconform. Route comes from
# openshift/v4.15-strict, ServiceMonitor from monitoring.coreos.com.
CRDS_CATALOG_COMMIT=4c8dc296d32b06d15ccde9668ff136c951f4d539

# openshift/api: the Route CRD, with its CEL rules, that the install test
# applies to a kind cluster (route/v1/zz_generated.crd-manifests/routes.crd.yaml).
OPENSHIFT_API_COMMIT=f8795cdde518111fddb944aa6118f93ebb632381

# prometheus-operator: the ServiceMonitor CRD for the same test.
PROMETHEUS_OPERATOR_VERSION=v0.94.1

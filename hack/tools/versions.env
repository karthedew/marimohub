# Exact, checksum-or-module-verified tool versions for local development and
# CI. `make bootstrap-tools` installs every tool below into the repo-owned
# `.bin/` directory; `make verify-tools` checks what is actually installed
# against this file. Nothing here is a floating tag: bump a version here,
# rerun bootstrap, and every consumer moves together.
#
# Compatibility rationale
# ------------------------
# KUBEBUILDER_VERSION, CONTROLLER_RUNTIME_VERSION, CONTROLLER_GEN_VERSION, and
# KUSTOMIZE_VERSION are the exact dependency set kubebuilder v4.15.0 (its
# newest release) upgraded to together: controller-runtime v0.24.1 and
# controller-tools (controller-gen) v0.21.0. Taking them as a matched set
# avoids the drift that comes from pinning controller-runtime and
# controller-gen independently against whatever each project's HEAD happens
# to be.
#
# KUBERNETES_MINOR fixes the one Kubernetes minor that KUBECTL_VERSION,
# KIND_VERSION's node image, and ENVTEST_K8S_VERSION all target. 1.35 is a
# currently-supported minor (not yet in maintenance mode) one step behind the
# newest published kubebuilder-qualified release (1.36), which gives the
# longest remaining support window while still sitting inside
# controller-runtime's guaranteed REST compatibility range. ENVTEST_K8S_VERSION
# is pinned to 1.35.0 because the envtest binary archive is only published
# once per minor at GA (`setup-envtest list` shows no 1.35.x patch beyond
# .0); the envtest apiserver/etcd pair does not need to track kubectl's patch
# level.
#
# Go itself is not vendored into .bin/: marimohub-operator's go.mod pins
# `go 1.26.5` with GOTOOLCHAIN=auto, so any host Go >= GO_MIN_HOST_VERSION
# transparently downloads and uses the pinned 1.26.5 toolchain per invocation
# (verified end-to-end in this environment against a Go 1.22.2 host). Podman
# is a host prerequisite for the same reason the plan calls out: it is a
# system container engine, not a relocatable binary, so verify-tools checks
# for it on PATH instead of installing it.
#
# Node is likewise a host prerequisite rather than something bootstrap-tools
# vendors: `frontend/package.json`'s "engines" field and `frontend/.nvmrc`
# carry the same constraint so npm, nvm, and this file cannot drift apart.
# NODE_MIN_VERSION is jsdom 30's own `engines.node` requirement (the
# strictest transitive dependency in the frontend tree, stricter than the
# sibling packages that also gate on Node 22) -- an unpinned Node under that
# floor fails `npm ci` with EBADENGINE, or, if that check is bypassed,
# installs a broken native binding for the platform-specific optional
# dependencies vite's Rolldown bundler resolves per Node ABI. NODE_VERSION is
# the exact release `frontend/.nvmrc` and CI pin, verified end-to-end
# (install, check, unit tests, build) in this environment.

# ── Go ──────────────────────────────────────────────────────────────────────
GO_VERSION=1.26.5
GO_MIN_HOST_VERSION=1.21.0

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_VERSION=22.23.2
NODE_MIN_VERSION=22.22.2

# ── Target Kubernetes minor ─────────────────────────────────────────────────
KUBERNETES_MINOR=1.35
KUBECTL_VERSION=v1.35.7
KIND_VERSION=v0.32.0
KIND_NODE_IMAGE=kindest/node:v1.35.5
ENVTEST_K8S_VERSION=1.35.0

# ── Operator toolchain (matched kubebuilder v4.15.0 dependency set) ────────
KUBEBUILDER_VERSION=v4.15.0
CONTROLLER_RUNTIME_VERSION=v0.24.1
CONTROLLER_GEN_VERSION=v0.21.0
KUSTOMIZE_VERSION=v5.8.1
SETUP_ENVTEST_VERSION=v0.24.1

# ── Packaging and cluster access ────────────────────────────────────────────
HELM_VERSION=v3.21.3
OC_VERSION=4.22.6

# ── kind NetworkPolicy-capable CNI (applied by hack/smoke/kind, Phase 8) ───
CALICO_VERSION=v3.32.1

# ── Supply chain security ──────────────────────────────────────────────────
SYFT_VERSION=v1.50.0
GRYPE_VERSION=v0.116.1
TRIVY_VERSION=v0.72.0
COSIGN_VERSION=v2.6.4

# ── Manifest linters ────────────────────────────────────────────────────────
KUBE_LINTER_VERSION=v0.8.3
KUBECONFORM_VERSION=v0.8.0
